# India Impact Graph — Local Environment Configuration Template
# Copy this file to '.env' and update with your local environment values.
# DO NOT commit real passwords, secrets, or production credentials to version control.

# Database Configuration (PostgreSQL 18 via psycopg 3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/india_impact_graph

# Trusted CORS Origins (comma-separated or JSON array)
# Wildcards (*) and null are rejected for security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Financial Event Extraction Provider Settings
# When False (default), uses deterministic rule-based fallback and FakeDeterministicProvider
USE_LIVE_LLM=false
LIVE_LLM_API_KEY=
