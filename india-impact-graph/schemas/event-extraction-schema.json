{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://india-impact-graph.org/schemas/event-extraction-schema.json",
  "title": "FinancialEventExtraction",
  "description": "Validation schema for structured event details extracted by the Reader LLM from financial news text or scenario inputs.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "is_scenario",
    "entities",
    "evidence_snippets"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique slug identifying the event or scenario (e.g., 'crude-oil-shock-12pct')."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "commodity_price_shock",
        "geopolitical_conflict",
        "central_bank_policy_rate",
        "trade_regulatory_shift",
        "macroeconomic_indicator_release"
      ],
      "description": "High-level categorization of the financial event."
    },
    "headline": {
      "type": "string",
      "description": "Primary article headline or scenario brief title."
    },
    "is_scenario": {
      "type": "boolean",
      "description": "True if this is a hypothetical scenario (e.g. +12% crude oil shock), false if grounded in dated historical news."
    },
    "event_date": {
      "type": "string",
      "description": "Date of event in ISO-8601 format (YYYY-MM-DD) if stated; otherwise null or omitted.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "geography": {
      "type": "string",
      "description": "Primary geographical focus stated in the source (e.g., 'Global', 'India', 'Middle East')."
    },
    "magnitude": {
      "type": "object",
      "description": "Quantified change magnitude stated explicitly in the article.",
      "required": ["direction"],
      "properties": {
        "value": {
          "type": ["number", "null"],
          "description": "Numerical change if explicitly stated (e.g., 12 for +12%). Missing values remain null."
        },
        "unit": {
          "type": ["string", "null"],
          "description": "Unit of measurement (e.g., '%', 'USD/barrel', 'basis points')."
        },
        "direction": {
          "type": "string",
          "enum": ["increase", "decrease", "fluctuation", "unspecified"]
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "description": "Entities extracted from the text. Must be matched against curated graph vocabulary.",
      "items": {
        "type": "object",
        "required": ["entity_id", "name", "entity_type", "mention_text"],
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Normalized identifier (e.g., 'crude_oil', 'diesel', 'rbi_repo_rate')."
          },
          "name": {
            "type": "string",
            "description": "Human-readable entity name."
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "commodity",
              "household_item",
              "economic_indicator",
              "sector",
              "instrument_asset",
              "institution"
            ]
          },
          "mention_text": {
            "type": "string",
            "description": "Exact textual excerpt where the entity appeared in the article."
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_snippets": {
      "type": "array",
      "description": "Direct quotes from the input document supporting the extracted event and relationships.",
      "items": {
        "type": "object",
        "required": ["quote", "source_title"],
        "properties": {
          "quote": {
            "type": "string",
            "description": "Direct sentence from the text."
          },
          "source_title": {
            "type": "string",
            "description": "Publication or document title."
          },
          "source_url": {
            "type": ["string", "null"],
            "description": "Direct URL or file identifier."
          },
          "publication_date": {
            "type": ["string", "null"],
            "description": "Date article was published."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
